<!-- ════════════════════════════════════════════════════════════════
     SECTION 15: USB / HARDWARE DEVICE DETECTION
     ════════════════════════════════════════════════════════════════ -->
<group name="hardware_detection,">

  <rule id="100080" level="7">
    <if_group>syscheck</if_group>
    <match type="pcre2">^Registry Key '\[x(32|64)\] HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Enum\\USB</match>
    <description>USB/HID device plugged in on $(agent.name): $(syscheck.path)</description>
    <group>hardware,device_connect,usb,</group>
    <mitre><id>T1200</id></mitre>
  </rule>

  <rule id="100081" level="6">
    <if_group>syscheck</if_group>
    <match type="pcre2">^Registry Key '\[x(32|64)\] HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Enum\\USB</match>
    <match>deleted</match>
    <description>USB/HID device unplugged on $(agent.name): $(syscheck.path)</description>
    <group>hardware,device_disconnect,usb,</group>
    <mitre><id>T1200</id></mitre>
  </rule>

  <rule id="100082" level="7">
    <if_group>syscheck</if_group>
    <match type="pcre2">^Registry Key '\[x(32|64)\] HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Enum\\USBSTOR</match>
    <description>USB storage device plugged in on $(agent.name): $(syscheck.path)</description>
    <group>hardware,storage,device_connect,</group>
    <mitre><id>T1200</id></mitre>
  </rule>

  <rule id="100083" level="6">
    <if_group>syscheck</if_group>
    <match type="pcre2">^Registry Key '\[x(32|64)\] HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Enum\\USBSTOR</match>
    <match>deleted</match>
    <description>USB storage device unplugged on $(agent.name): $(syscheck.path)</description>
    <group>hardware,storage,device_disconnect,</group>
    <mitre><id>T1200</id></mitre>
  </rule>

  <rule id="100084" level="7">
    <if_group>syslog</if_group>
    <match>New USB device found|usb.*new device|New USB device</match>
    <description>USB device connected on $(agent.name): $(full_log)</description>
    <group>hardware,device_connect,linux,</group>
    <mitre><id>T1200</id></mitre>
  </rule>

  <rule id="100085" level="6">
    <if_group>syslog</if_group>
    <match>USB disconnect|usb.*disconnect</match>
    <description>USB device disconnected on $(agent.name): $(full_log)</description>
    <group>hardware,device_disconnect,linux,</group>
    <mitre><id>T1200</id></mitre>
  </rule>

  <rule id="100086" level="7">
    <if_group>syslog</if_group>
    <match>sd.*Attached SCSI removable disk|USB Mass Storage|scsi.*removable</match>
    <description>USB storage device connected on $(agent.name)</description>
    <group>hardware,storage,device_connect,linux,</group>
    <mitre><id>T1200</id></mitre>
  </rule>

  <rule id="100087" level="5">
    <if_sid>530</if_sid>
    <match>plug|connected|attach</match>
    <description>Hardware plugged in on $(agent.name): $(full_log)</description>
    <group>hardware,device_connect,linux,</group>
    <mitre><id>T1200</id></mitre>
  </rule>

  <rule id="100088" level="7">
    <if_group>syslog</if_group>
    <match>USB device|AppleUSB|IOUSBHostDevice</match>
    <description>USB device connected on $(agent.name): $(full_log)</description>
    <group>hardware,device_connect,macos,</group>
    <mitre><id>T1200</id></mitre>
    <ignore>300</ignore>
  </rule>

  <rule id="100089" level="5">
    <if_group>syslog</if_group>
    <match>USB|Thunderbolt|DisplayPort|HDMI|SD card|external drive</match>
    <regex>attach|detach|connect|disconnect|plug|unplug</regex>
    <field name="location">/var/log/|journald</field>
    <description>Hardware device event detected on $(agent.name)</description>
    <group>hardware,device_connect,macos,</group>
    <mitre><id>T1200</id></mitre>
  </rule>

  !-- ============================================================ -->
    <!-- TEMPORARY TEST — remove after verifying generic.py fallback  -->
    <!-- ============================================================ -->
    <rule id="100999" level="10">
      <match>DTIS_GENERIC_TEST</match>
      <description>DTIS TEST: generic.py fallback verification</description>
      <group>local,</group>
    </rule>

</group>

<group name="usb,hardware,">

  <rule id="100060" level="7">
    <if_sid>60103</if_sid>
