<!--
  ════════════════════════════════════════════════════════════════
  LOCAL RULES — DevAP-Wazuh-Local
  ════════════════════════════════════════════════════════════════

  STRUCTURE (in order — suppression rules must precede the alert
  rules they depend on, per Wazuh evaluation order):

    SECTION 1  : Suppression rules (noise + false positives)
    SECTION 2  : Critical registry alerts
    SECTION 3  : Authentication & brute force
    SECTION 4  : Privilege escalation (sudo & su)
    SECTION 5  : Account management
    SECTION 6  : Persistence
    SECTION 7  : Malware / suspicious execution
    SECTION 8  : File integrity monitoring (FIM)
    SECTION 9  : Defense evasion
    SECTION 10 : Network
    SECTION 11 : Web attacks
    SECTION 12 : Ransomware
    SECTION 13 : Correlation rules
    SECTION 14 : Agent status & management
    SECTION 15 : USB / hardware device detection
    SECTION 16 : Late suppressions (must follow the rules they suppress)

  RULE ID RANGES (documented so future IDs don't collide):
    190000–190099  suppression rules (early)
    190100–190199  suppression rules (late — must follow their target rule)
    100001–100099  primary alert rules (auth, privesc, persistence,
                    malware, fim, evasion, network, web)
    100300–100399  frequency/threshold-based alert rules
    100500–100599  agent connectivity status
    199000–199099  Windows registry rules (suppression + critical)

  Maps to: /var/ossec/integrations/security_events/config.py
           RULE_CATEGORY_MAP — every alert-producing rule ID below
           should have a corresponding entry there.

  CHANGE LOG (this revision):
    - Fixed: rule 190100 was suppressing service-stop events for
      wazuh-manager/wazuh-agent/wazuh-api/wazuh-active/wazuh-indexer
      by name-substring match, meaning an attacker stopping Wazuh's
      own services to blind the SIEM generated no alert. Split those
      names out of 190100 into a new always-alert rule 100017, at
      higher severity, specifically for security-tooling stops.
      190100 itself is kept, scoped to genuinely low-value services.
    - Removed two stale comments in Section 1 that referenced
      suppression rules which don't actually exist in this file
      (their real implementation lives in Section 16, late
      suppressions — comments were leftover from refactoring).
  ════════════════════════════════════════════════════════════════
-->


<!-- ════════════════════════════════════════════════════════════════
     SECTION 1: SUPPRESSION RULES (must come first)
     ════════════════════════════════════════════════════════════════ -->

<group name="noise_suppression,">


 <!-- Suppress 100089 false positives from Proxmox QEMU/SCA logs -->
  <rule id="190033" level="0">
    <if_sid>100089</if_sid>
    <match>logger-helper|upsertElement|wm_sca|usbmux</match>
    <description>Suppressed: 100089 false positive from Proxmox/SCA internal logs</description>
  </rule>

  <!-- Suppress web attack false positive from DC PVE (agent 007) -->
  <rule id="190024" level="0">
    <if_sid>100013</if_sid>
    <field name="agent.name">DevAP-DC-PVE-LOCAL</field>
    <description>Suppressed: Web attack false positive from DC PVE</description>
  </rule>

  <!-- Suppress Rule 100001 for SU events -->
  <rule id="190032" level="0">
    <if_sid>100001</if_sid>
    <field name="decoder.name">su</field>
    <description>Suppressed: SU event should use SU rules (100054-100056)</description>
  </rule>


  <!-- Suppress indexer-connector retry noise -->
  <rule id="190025" level="0">
    <if_group>syslog</if_group>
    <match>indexerConnector|indexer-connector|IndexerConnector</match>
    <description>Suppressed: Wazuh indexer connector internal messages</description>
  </rule>

  <!-- Suppress monitoring health check noise -->
  <rule id="190026" level="0">
    <if_group>syslog</if_group>
    <match>Health check failed</match>
    <field name="location">/var/ossec/logs/ossec.log</field>
    <description>Suppressed: Wazuh internal health check failures</description>
  </rule>

  <!-- Suppress Windows Software Protection scheduled task -->
  <rule id="190021" level="0">
    <if_sid>100008</if_sid>
    <match>Software Protection|sppsvc|RulesEngine</match>
    <description>Suppressed: Windows Software Protection scheduled task</description>
  </rule>

  <!-- Suppress Windows Task Scheduler normal operation -->
  <rule id="190022" level="0">
    <if_sid>100008</if_sid>
    <match>Task Scheduler|taskschd|MaintenanceScheduler|USOScheduler</match>
    <description>Suppressed: Windows Task Scheduler normal operation</description>
  </rule>

  <!-- Suppress Windows System error events — low value -->
  <rule id="190023" level="0">
    <if_sid>61102</if_sid>
    <description>Suppressed: Windows System error event (low value)</description>
  </rule>

  <!-- Suppress PAM session open/close noise -->
  <rule id="190001" level="0">
    <if_sid>5501</if_sid>
    <description>Suppressed: PAM session opened</description>
  </rule>

  <rule id="190002" level="0">
    <if_sid>5502</if_sid>
    <description>Suppressed: PAM session closed</description>
  </rule>

  <!-- Suppress SSH login accepted (informational only) -->
  <rule id="190004" level="0">
    <if_sid>5715</if_sid>
    <description>Suppressed: SSH login accepted from known location</description>
  </rule>

  <!-- Suppress noisy SSHD messages -->
  <rule id="190010" level="0">
    <if_sid>5709,5711,5721,5722,5729</if_sid>
    <description>Suppressed: Low-value SSHD messages</description>
  </rule>

  <!-- Suppress Windows normal logon/logoff -->
  <rule id="190009" level="0">
    <if_sid>60103,60137</if_sid>
    <description>Suppressed: Windows normal logon/logoff</description>
  </rule>

</group>


