    <mitre><id>T1200</id></mitre>
  </rule>

</group>

<!-- ════════════════════════════════════════════════════════════════
     SECTION 16: LATE SUPPRESSIONS (must come after rule definitions above)
     ════════════════════════════════════════════════════════════════ -->
<group name="late_suppression,">

  <!-- Suppress rule 100008 firing on Wazuh manager's own internal logs -->
  <rule id="190020" level="0">
    <if_sid>100008</if_sid>
    <field name="agent.id" type="pcre2">^000$</field>
    <description>Suppressed: Rule 100008 false positive from Wazuh manager internal logs</description>
  </rule>

  <!-- Suppress rule 100008 false positive from SCA "useradd -D" check -->
  <rule id="190027" level="0">
    <if_sid>100008</if_sid>
    <match>useradd -D|INACTIVE=|compare &lt;= 30</match>
    <description>Suppressed: Rule 100008 false positive from SCA useradd check</description>
  </rule>

  <!-- Suppress rule 100008 from SCA crontab permission check -->
  <rule id="190028" level="0">
    <if_sid>100008</if_sid>
    <match>stat -Lc|/etc/crontab|/etc/cron|Ensure permissions</match>
    <description>Suppressed: Rule 100008 false positive from SCA crontab check</description>
  </rule>

  <!-- Suppress rule 100008 from SCA wm_sca debug lines -->
  <rule id="190029" level="0">
    <if_sid>100008</if_sid>
    <match>wm_sca|sca\[|Considering rule|Running command|Executing command</match>
    <description>Suppressed: Rule 100008 false positive from SCA debug output</description>
  </rule>

  <!-- Suppress rule 100006 false positive from SCA "useradd -D" check -->
  <rule id="190030" level="0">
    <if_sid>100006</if_sid>
    <match>useradd -D|INACTIVE=|wm_sca|sca\[</match>
    <description>Suppressed: Rule 100006 false positive from SCA useradd -D check</description>
  </rule>

  <!-- Suppress rule 100007 false positive from SCA -->
  <rule id="190031" level="0">
    <if_sid>100007</if_sid>
    <match>wm_sca|sca\[|Considering rule|Running command</match>
    <description>Suppressed: Rule 100007 false positive from SCA scan</description>
  </rule>

  <!-- Suppress 100001 false positive from Wazuh internal ossec.log -->
  <rule id="190103" level="0">
    <if_sid>100001</if_sid>
    <field name="agent.id" type="pcre2">^000$</field>
    <description>Suppressed: 100001 false positive from Wazuh manager internal restart noise</description>
  </rule>

  <!-- Suppress Docker container scope start/stop noise -->
  <rule id="190102" level="0">
    <if_sid>100011,100016</if_sid>
    <match>docker-.*\.scope|libcontainer container</match>
    <description>Suppressed: Docker container scope noise</description>
  </rule>

  <!-- Suppress systemd targets and user session noise from logout/login -->
  <rule id="190101" level="0">
    <if_sid>100011</if_sid>
    <match>^target |User Manager for UID|User Runtime Directory|Main User Target|Basic System|Paths|Timers|Sockets|Slices|Local File Systems|Network is Online|Remote File Systems</match>
    <description>Suppressed: Systemd target/session teardown noise</description>
  </rule>

  <!-- Suppressed low-value service stops — scoped to genuinely noisy,
       non-security-relevant services only. Security/monitoring tooling
       (wazuh-*, ssh, rsyslog, filebeat, systemd-journald, snmpd, auditd,
       falcon-sensor, clamd) was moved OUT of this list and into rule
       100017/100018 above, which always alert on those regardless of
       this suppression group, at higher severity.

       FIXED 2026-07-06: ssh|rsyslog|filebeat were still listed here
       despite being explicitly confirmed as always-critical services.
       Even though 100017 fired correctly for them (rules 100011 and
       100017 evaluate independently, so 190100 suppressing the generic
       100011 copy never blocked 100017), leaving them here was
       misleading dead weight and a future maintenance trap — if
       100017/100018 are ever removed or edited without checking this
       list, these three would silently go back to fully suppressed.
       Removed for clarity and defense-in-depth.
       Do not re-add security-tooling service names here. -->
  <rule id="190100" level="0">
    <if_sid>100011</if_sid>
    <match>snapd|systemd-timesyncd|unattended|ModemManager|udisks|accounts-daemon|atd|cron|dbus|irqbalance|multipathd|networkd|polkit|postfix|upower|getty</match>
    <description>Suppressed: Normal service stop — not security relevant</description>
  </rule>

  <rule id="190107" level="0">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">\.(log|json|tmp|bak|swp|cache|lock|pid|db|sqlite|csv|out|gz|zip|tar)$</field>
    <description>Suppressed: global noisy extension filter (auto-managed by add_fim_dir.sh)</description>
  </rule>








  <rule id="190108" level="0">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">^/var/ossec/integrations/(?!.*\.(py)$).*$</field>
    <description>Suppressed: non-matching extension change in /var/ossec/integrations</description>
  </rule>

</group>


<!-- ════════════════════════════════════════════════════════════════
     SECTION 17: NOISE SUPPRESSION FOR STOCK RULES
     ════════════════════════════════════════════════════════════════ -->
<group name="local,noise_suppression,">

  <!-- Suppress rule 597 flood from routine Windows service registry
       cleanup during scheduled FIM scans (e.g. cbdhsvc_*, webthreat-
       defusersvc_*) — these are OS-internal service teardown, not
       attacker activity. Genuine realtime 597 events not matching
       this pattern still alert normally. -->
  <rule id="190105" level="0">
    <if_sid>597</if_sid>
    <match type="pcre2">Services\\[A-Za-z]+_[0-9a-f]{5,8}</match>
    <description>Suppressed: routine per-session Windows service registry cleanup</description>
  </rule>

</group>

<!-- Suppress dpkg transitional states — half-configured is an
     intermediate step during every install/upgrade, not a
     standalone event worth alerting on. 2902 (installed) and
     2903 (removed) still alert normally. -->
<group name="local,noise_suppression,">
  <rule id="190106" level="0">
    <if_sid>2904</if_sid>
    <description>Suppressed: dpkg transitional state (half-configured)</description>
  </rule>
</group>
