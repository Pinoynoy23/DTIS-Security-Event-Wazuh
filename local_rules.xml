<!-- ════════════════════════════════════════════════════════════════
     SECTION 2: CRITICAL REGISTRY ALERTS
     ════════════════════════════════════════════════════════════════ -->
<group name="registry_critical,">

  <rule id="199008" level="10">
    <if_sid>594,598,750,751,752</if_sid>
    <match>Run|RunOnce|RunServices</match>
    <description>CRITICAL: Registry persistence key modified on $(agent.name): $(syscheck.path)</description>
    <group>persistence,registry,</group>
    <mitre><id>T1547.001</id></mitre>
  </rule>

  <rule id="199009" level="10">
    <if_sid>594,598,750,751,752</if_sid>
    <match>Userinit</match>
    <description>CRITICAL: Userinit registry key modified on $(agent.name)</description>
    <group>persistence,registry,</group>
    <mitre><id>T1547</id></mitre>
  </rule>

  <rule id="199010" level="10">
    <if_sid>594,598,750,751,752</if_sid>
    <match>Shell|Explorer\\Run</match>
    <description>CRITICAL: Shell registry key modified on $(agent.name)</description>
    <group>persistence,registry,</group>
    <mitre><id>T1547</id></mitre>
  </rule>

  <rule id="199011" level="10">
    <if_sid>594,598,750,751,752</if_sid>
    <match>Windows Defender|AntiSpyware|DisableRealtimeMonitoring</match>
    <description>CRITICAL: Windows Defender registry modified on $(agent.name)</description>
    <group>defense_evasion,registry,</group>
    <mitre><id>T1562.001</id></mitre>
  </rule>

  <rule id="199012" level="10">
    <if_sid>594,598,750,751,752</if_sid>
    <match>EnableLUA|ConsentPromptBehaviorAdmin</match>
    <description>CRITICAL: UAC registry modified on $(agent.name)</description>
    <group>defense_evasion,registry,</group>
    <mitre><id>T1548.002</id></mitre>
  </rule>

</group>


<!-- ════════════════════════════════════════════════════════════════
     SECTION 3: AUTHENTICATION & BRUTE FORCE
     ════════════════════════════════════════════════════════════════ -->
<group name="local,syslog,sshd,ddos,">

  <rule id="100300" level="10" frequency="8" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>Possible SSH brute-force or DoS from $(srcip) on $(agent.name)</description>
    <group>sshd,authentication_failed,bruteforce,ddos,</group>
  </rule>

  <rule id="100001" level="4">
    <if_group>authentication_failed</if_group>
    <description>Failed login attempt on $(agent.name)</description>
    <group>authentication,pci_dss_10.2.4,pci_dss_10.2.5,gpg13_7.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100002" level="7" frequency="5" timeframe="60">
    <if_matched_sid>100001</if_matched_sid>
    <same_source_ip />
    <description>Multiple failed logins from $(srcip) on $(agent.name) — possible brute force</description>
    <group>authentication_failures,pci_dss_11.4,gdpr_IV_35.7.d,</group>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100003" level="10" frequency="10" timeframe="30">
    <if_matched_sid>100001</if_matched_sid>
    <same_source_ip />
    <match>sshd</match>
    <description>SSH brute force attack from $(srcip) on $(agent.name)</description>
    <group>authentication_failures,pci_dss_11.4,gdpr_IV_35.7.d,</group>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100004" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100001</if_matched_sid>
    <same_source_ip />
    <different_user />
    <description>Password spraying from $(srcip) targeting multiple accounts on $(agent.name)</description>
    <group>authentication_failures,</group>
    <mitre><id>T1110.003</id></mitre>
  </rule>

</group>


<!-- ════════════════════════════════════════════════════════════════
     SECTION 4: PRIVILEGE ESCALATION (sudo & su)
     ════════════════════════════════════════════════════════════════ -->
<group name="local,syslog,privilege_escalation,">

  <rule id="100005" level="12">
    <if_sid>5400</if_sid>
    <match>COMMAND=|authentication failure</match>
    <description>Privilege escalation via sudo on $(agent.name)</description>
    <group>privilege_escalation,pci_dss_10.2.5,</group>
    <mitre><id>T1068</id></mitre>
  </rule>

  <rule id="100050" level="8">
    <if_sid>5402</if_sid>
    <description>User executed command as root via sudo on $(agent.name)</description>
    <group>privilege_escalation,pci_dss_10.2.5,</group>
    <mitre><id>T1068</id></mitre>
  </rule>

  <rule id="100051" level="8">
    <if_sid>5401</if_sid>
    <description>User switched to root via su on $(agent.name)</description>
    <group>privilege_escalation,pci_dss_10.2.5,</group>
    <mitre><id>T1068</id></mitre>
  </rule>

  <rule id="100070" level="8">
    <decoded_as>su</decoded_as>
    <description>SU command detected: User switched to root on $(agent.name)</description>
    <group>privilege_escalation,su,</group>
    <mitre><id>T1068</id></mitre>
  </rule>

  <rule id="100071" level="6">
    <if_sid>5501</if_sid>
    <match>su: |authentication failure</match>
    <description>SU command FAILED on $(agent.name)</description>
    <group>privilege_escalation,su,</group>
    <mitre><id>T1068</id></mitre>
  </rule>

</group>


<!-- ════════════════════════════════════════════════════════════════
     SECTION 5: ACCOUNT MANAGEMENT
     ════════════════════════════════════════════════════════════════ -->
<group name="local,syslog,account_management,">

  <rule id="100006" level="8">
    <if_group>syslog</if_group>
    <match>useradd|adduser|net user /add|New-LocalUser</match>
    <regex negate="yes" type="pcre2">useradd -D|wm_sca|sca\[|INACTIVE=</regex>
    <description>New user account created on $(agent.name) by $(user)</description>
    <group>account_management,pci_dss_10.2.5,</group>
    <mitre><id>T1136</id></mitre>
  </rule>

  <rule id="100007" level="10">
    <if_group>syslog</if_group>
    <match>usermod|gpasswd|net localgroup|Add-LocalGroupMember</match>
    <regex>sudo|wheel|admin|Administrator|Domain Admins</regex>
    <description>User added to privileged group on $(agent.name)</description>
    <group>account_management,privilege_escalation,</group>
    <mitre><id>T1098</id></mitre>
  </rule>

</group>


<!-- ════════════════════════════════════════════════════════════════
     SECTION 6: PERSISTENCE
     ════════════════════════════════════════════════════════════════ -->
<group name="local,syslog,persistence,">

  <rule id="100008" level="10">
    <if_group>syslog</if_group>
    <match>crontab|systemctl enable|schtasks|Register-ScheduledTask|New-ScheduledTask</match>
    <description>Persistence mechanism detected on $(agent.name) — scheduled task or service</description>
    <group>persistence,pci_dss_10.2.7,</group>
    <mitre><id>T1053</id></mitre>
  </rule>

  <rule id="100015" level="10">
    <if_group>syslog</if_group>
    <regex type="pcre2">^.*\bat\b\s+\d</regex>
    <description>Persistence mechanism detected on $(agent.name) — at job scheduled</description>
    <group>persistence,pci_dss_10.2.7,</group>
    <mitre><id>T1053</id></mitre>
  </rule>

</group>


<!-- ════════════════════════════════════════════════════════════════
     SECTION 7: MALWARE / SUSPICIOUS EXECUTION
     ════════════════════════════════════════════════════════════════ -->
<group name="local,syslog,malware,">

  <rule id="100009" level="12">
  <if_group>windows</if_group>
  <field name="win.system.channel">Microsoft-Windows-PowerShell/Operational</field>
  <regex>-enc|-EncodedCommand|IEX|Invoke-Expression|DownloadString|WebClient|Start-Process.*http|bitsadmin|certutil.*urlcache</regex>
  <description>Suspicious script execution / malware behavior on $(agent.name)</description>
  <group>malware,execution,</group>
  <mitre><id>T1059</id></mitre>
</rule>

</group>


<!-- ════════════════════════════════════════════════════════════════
     SECTION 8: FILE INTEGRITY MONITORING (FIM)
     ════════════════════════════════════════════════════════════════ -->
<group name="local,syscheck,fim,">

  <!-- FIXED 2026-07-06: unanchored substring match could false-positive
       on backup/staging copies containing these paths as a substring,
       e.g. /home/user/backup/etc/passwd.bak or /mnt/restore/etc/shadow.
       Anchored with ^...$ so only the exact canonical paths match. -->
  <rule id="100010" level="8">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">^(/etc/passwd|/etc/shadow|/etc/sudoers|/etc/ssh/sshd_config)$</field>
    <description>Critical system file modified on $(agent.name): $(file)</description>
    <group>fim,pci_dss_11.5,</group>
    <mitre><id>T1565</id></mitre>
  </rule>

  <rule id="100040" level="8">
    <if_sid>554</if_sid>
    <field name="file">/var/ossec/integrations</field>
    <description>FIM — New file added to Wazuh integrations folder: $(file)</description>
    <group>fim,file_added,</group>
    <mitre><id>T1565</id></mitre>
  </rule>

  <rule id="100041" level="8">
    <if_sid>550</if_sid>
    <field name="file">/var/ossec/integrations</field>
    <description>FIM — File modified in Wazuh integrations folder: $(file)</description>
    <group>fim,file_modified,</group>
    <mitre><id>T1565</id></mitre>
  </rule>

  <rule id="100042" level="8">
    <if_sid>553</if_sid>
    <field name="file">/var/ossec/integrations</field>
    <description>FIM — File deleted from Wazuh integrations folder: $(file)</description>
    <group>fim,file_deleted,</group>
    <mitre><id>T1565</id></mitre>
  </rule>

</group>


<!-- ════════════════════════════════════════════════════════════════
     SECTION 9: DEFENSE EVASION
     ════════════════════════════════════════════════════════════════ -->
<group name="local,systemd,defense_evasion,">

  <!-- Catch ANY service stop via systemd — no keyword list needed -->
  <rule id="100011" level="7">
    <if_sid>40700,40701,40702,40703,40704</if_sid>
    <match>Stopping|Stopped</match>
    <description>Service stopped on $(agent.name)</description>
    <group>defense_evasion,service_stop,</group>
    <mitre><id>T1562</id></mitre>
  </rule>

  <!-- Security/monitoring tooling stop — NEVER suppressed by name in late
       suppressions (see 190100). Always alerts, at higher severity, since
       stopping these is a defense-evasion action in its own right and is
       what correlation rule 100023 depends on detecting reliably.

       List built from actual running services on DevAP-Wazuh-Local
       (systemctl list-units, type service, state running), reviewed
       2026-07-03. Covers: Wazuh stack (manager/indexer/dashboard/API
       poller/active-response), custom SOC tooling (ap-soc-dashboard,
       ap-soc-monitor), remote access (ssh), logging pipeline
       (rsyslog, filebeat, systemd-journald), and network monitoring
       (snmpd), plus generic security tools (auditd, falcon-sensor, clamd)
       as forward-looking coverage if ever installed. -->
  <rule id="100017" level="13">
    <if_sid>40700,40701,40702,40703,40704</if_sid>
    <match>Stopping|Stopped</match>
    <regex>wazuh-manager|Wazuh manager|wazuh-agent-monitor|Wazuh Agent Add/Remove Monitor|wazuh-agent|wazuh-api|Wazuh API Agent Status Poller|wazuh-active|wazuh-telegram|wazuh-indexer|wazuh-dashboard|ap-soc-dashboard|AP SOC Monitor Dashboard|ap-soc-monitor|AP Security Operations Center Monitor|ssh\.service|sshd|Secure Shell|rsyslog|System Logging Service|filebeat|Filebeat|systemd-journald|Journal Service|snmpd|Simple Network Management Protocol|auditd|falcon-sensor|clamd</regex>
    <description>CRITICAL: Security/monitoring service stopped on $(agent.name) — possible defense evasion</description>
    <group>defense_evasion,critical,security_tooling,</group>
    <mitre><id>T1562.001</id></mitre>
  </rule>

  <!-- Critical service (re)start — always alerts too, per user requirement.
       An attacker stopping a critical service, doing something, then
       restarting it to hide the gap is a real pattern; the restart itself
       is a signal worth seeing, not just the stop. Same service list as
       100017, same severity tier below CRITICAL since a start is lower
       risk than a stop but still worth immediate attention. -->
  <rule id="100018" level="10">
    <if_sid>40700,40701,40702,40703,40704</if_sid>
    <match>Started</match>
    <regex>wazuh-manager|Wazuh manager|wazuh-agent-monitor|Wazuh Agent Add/Remove Monitor|wazuh-agent|wazuh-api|Wazuh API Agent Status Poller|wazuh-active|wazuh-telegram|wazuh-indexer|wazuh-dashboard|ap-soc-dashboard|AP SOC Monitor Dashboard|ap-soc-monitor|AP Security Operations Center Monitor|ssh\.service|sshd|Secure Shell|rsyslog|System Logging Service|filebeat|Filebeat|systemd-journald|Journal Service|snmpd|Simple Network Management Protocol|auditd|falcon-sensor|clamd</regex>
    <description>Security/monitoring service (re)started on $(agent.name)</description>
    <group>defense_evasion,security_tooling,service_start,</group>
    <mitre><id>T1562.001</id></mitre>
  </rule>

  <!-- Generic service start — excludes critical services (100018 fires for
       those instead) to avoid double-alerting, and excludes .scope units
       (GUI app launches / process-tracking cgroups, not real services).

       Set to level 0 (never alerts) as of 2026-07-03: observed in
       production flooding Telegram delivery with near-zero-value
       "app-gnome-*.scope started" noise from a desktop VM agent, which
       hit Telegram's 429 rate limit and queued behind it, delaying/
       burying a real SSH brute-force alert (100001/100002) that fired
       during the same window. Service starts are inherently lower
       priority than stops (100011) for defense-evasion purposes — an
       attacker restarting something to hide a gap is caught by 100018
       for the services that matter; routine starts of arbitrary
       software are not worth the delivery cost. -->
    <rule id="100016" level="7">
  <if_sid>40700,40701,40702,40703,40704</if_sid>
  <match>Started</match>
  <regex negate="yes" type="pcre2">\.scope$|app-gnome-|docker-.*\.scope|wazuh-manager|Wazuh manager|wazuh-agent-monitor|Wazuh Agent Add/Remove Monitor|wazuh-agent|wazuh-api|Wazuh API Agent Status Poller|wazuh-active|wazuh-telegram|wazuh-indexer|wazuh-dashboard|ap-soc-dashboard|AP SOC Monitor Dashboard|ap-soc-monitor|AP Security Operations Center Monitor|ssh\.service|sshd|Secure Shell|rsyslog|System Logging Service|filebeat|Filebeat|systemd-journald|Journal Service|snmpd|Simple Network Management Protocol|auditd|falcon-sensor|clamd</regex>
  <description>Service started on $(agent.name)</description>
  <group>service_start,</group>
</rule>

</group>


<!-- ════════════════════════════════════════════════════════════════
     SECTION 10: NETWORK
     ════════════════════════════════════════════════════════════════ -->
<group name="local,firewall,network,">

 <!-- New intermediate rule: fires (quietly, level 3) on every firewall-group
     event, giving 100012 a real, non-zero-level rule to build frequency
     correlation from. Rule 4100 (built-in, level 0) does NOT reliably
     support cross-event frequency tracking for if_matched_sid/if_matched_group
     — confirmed via wazuh-logtest: firedtimes counted correctly per-event,
     but 100012's frequency=6/timeframe=30 never triggered despite 6
     same-source-IP matches well within the window. -->
 <rule id="100019" level="3">
  <if_group>firewall</if_group>
  <regex type="pcre2" negate="yes">SRC=(\S+) DST=\1(?!\S)</regex>
  <description>Firewall connection event on $(agent.name) from $(srcip)</description>
  <group>firewall_event,</group>
</rule>

 <rule id="100012" level="9" frequency="6" timeframe="30">
  <if_matched_sid>100019</if_matched_sid>
  <same_source_ip />
  <description>Port scanning detected from $(srcip) on $(agent.name) — 6+ connection attempts within 30s</description>
  <group>network_scan,recon,</group>
  <mitre><id>T1046</id></mitre>
  <ignore>60</ignore>
</rule>

</group>

<!-- ════════════════════════════════════════════════════════════════
     SECTION 11: WEB ATTACKS
     ════════════════════════════════════════════════════════════════ -->
<group name="local,web,">

  <!-- HARDENED 2026-07-06: original regex had several loose patterns
       prone to false positives on completely benign log lines:
         - "select.*from" matched ANY line containing both words
           anywhere, e.g. app UI text like "select an option from
           the menu" or normal SQL admin tooling logs
         - ";.*whoami" / ";.*ls" / ";.*cat" matched innocuous text
           containing "ls", "cat", "id", or "whoami" as substrings
           anywhere after a semicolon, not just as shell commands
       Tightened to require adjacency/specific SQL syntax shape rather
       than "these two words appear somewhere in the same line", and
       anchored the CMDi patterns to actual command-separator syntax.
       This does NOT weaken real detection: genuine SQLi/CMDi payloads
       still match, since attackers use these exact adjacent patterns
       (e.g. "UNION SELECT ... FROM", "; whoami", "; cat /etc/passwd"). -->
  <!-- FIXED 2026-07-06 (critical): <same_source_ip/> was added here
       without a paired frequency/if_matched clause, which is invalid
       Wazuh rule syntax on its own — same_source_ip only has meaning as
       part of a correlation rule. This caused wazuh-analysisd to reject
       the entire local_rules.xml file at load time (CRITICAL error,
       manager failed to start). Removed; the hardened regex below is
       unaffected and was already verified against 12 real attack
       payloads and 5 false-positive strings before this element was
       mistakenly added. -->
  <rule id="100013" level="10">
  <if_group>web</if_group>
  <url>union%20|union+|select%20|select+|insert%20into%20|insert+into+|drop%20table|drop+table|%20from%20|+from+|xp_cmdshell|%2e%2e%2f|%2e%2e\/</url>
  <description>Web attack on $(agent.name) from $(srcip) — SQLi/Traversal (URL-encoded)</description>
  <group>web_attack,pci_dss_6.5,</group>
  <mitre><id>T1190</id></mitre>
</rule>

<rule id="100026" level="10">
  <if_group>web</if_group>
  <regex type="pcre2">&lt;script[\s&gt;]|javascript:|onerror\s*=|onload\s*=|;\s*(ls|cat|whoami|id)(\s|$|;)</regex>
  <description>Web attack on $(agent.name) from $(srcip) — XSS/CMDi</description>
  <group>web_attack,pci_dss_6.5,</group>
  <mitre><id>T1190</id></mitre>
</rule>

</group>


<!-- ════════════════════════════════════════════════════════════════
     SECTION 12: RANSOMWARE
     ════════════════════════════════════════════════════════════════ -->
<group name="local,syscheck,ransomware,">

  <rule id="100014" level="15">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">\.locked$|\.encrypted$|\.ransom$|\.crypt$|HELP_DECRYPT|READ_ME_ENCRYPTED</field>
    <description>RANSOMWARE INDICATORS on $(agent.name) — file marker detected: $(file)</description>
    <group>ransomware,critical,</group>
    <mitre><id>T1486</id></mitre>
  </rule>
  <!-- Ransomware indicator: shadow-copy/recovery deletion commands -->
<!-- FIXED: these are command executions, not file-integrity events —
     if_group syscheck could never match them. Moved to syslog group,
     same as rule 100009's command-detection pattern. -->
  <rule id="100025" level="15">
    <if_group>windows</if_group>
    <field name="win.system.channel">Microsoft-Windows-PowerShell/Operational</field>
    <regex type="pcre2">vssadmin.*delete|wmic.*shadowcopy.*delete|bcdedit.*recoveryenabled.*no</regex>
    <description>RANSOMWARE INDICATORS on $(agent.name) — shadow copy/recovery deletion command detected</description>
    <group>ransomware,critical,</group>
    <mitre><id>T1490</id><id>T1486</id></mitre>
  </rule>
</group>


<!-- ════════════════════════════════════════════════════════════════
     SECTION 13: CORRELATION RULES
     ════════════════════════════════════════════════════════════════ -->
<group name="local,correlation,">

  <rule id="100020" level="12" frequency="2" timeframe="300">
    <if_matched_sid>100002</if_matched_sid>
    <if_group>authentication_success</if_group>
    <same_source_ip />
    <description>CORRELATION: Brute force then successful login from $(srcip) — possible account compromise on $(agent.name)</description>
    <group>correlation,account_compromise,</group>
    <mitre><id>T1110</id><id>T1078</id></mitre>
  </rule>

  <rule id="100021" level="13" timeframe="120">
    <if_matched_sid>100006</if_matched_sid>
    <same_field name="agent.id" />
    <description>CORRELATION: New user created then added to privileged group on $(agent.name)</description>
    <group>correlation,persistence,privilege_escalation,</group>
    <mitre><id>T1136</id><id>T1098</id></mitre>
  </rule>

<rule id="100022" level="13" timeframe="300">
    <if_matched_sid>100012</if_matched_sid>
    <if_sid>100002,100003</if_sid>
    <same_source_ip />
    <description>CORRELATION: Port scan then SSH brute force from $(srcip) — active attack on $(agent.name)</description>
    <group>correlation,active_attack,</group>
    <mitre><id>T1046</id><id>T1110</id></mitre>
    <ignore>600</ignore>
  </rule>

  <!-- Now anchored to 100017 (the always-alert security-tooling stop rule)
       instead of the general 100011, since that's the signal this
       correlation is actually meant to catch: SIEM/EDR blinded + firewall
       disabled together. Previously depended on 100011, which the old
       190100 suppression could silently swallow for wazuh-* services. -->
  <rule id="100023" level="14" frequency="2" timeframe="120">
    <if_matched_sid>100017</if_matched_sid>
    <same_field name="agent.id" />
    <description>CORRELATION: Security agent stopped AND firewall disabled on $(agent.name)</description>
    <group>correlation,defense_evasion,critical,</group>
    <mitre><id>T1562</id></mitre>
  </rule>

  <!-- FIXED 2026-07-06: previous version only checked if_matched_sid=100010
       with frequency=2, meaning it fired when the SAME rule (critical file
       modified) repeated twice — not the chained "critical file THEN
       suspicious script" sequence the description claimed. That was a
       false-negative: a real attack pattern (modify /etc/passwd, then run
       a malicious PowerShell script) would NOT have triggered this
       correlation at all, since 100009 was never referenced.
       Now correctly requires 100010 to have fired first, then explicitly
       matches on 100009 (suspicious script execution) as the triggering
       event, both on the same agent within the window. -->
  <rule id="100024" level="15" timeframe="180">
    <if_matched_sid>100009</if_matched_sid>
    <if_sid>100010</if_sid>
    <same_field name="agent.id" />
    <description>CORRELATION: Critical file modified then suspicious script on $(agent.name) — possible ransomware</description>
    <group>correlation,ransomware,apt,critical,</group>
    <mitre><id>T1565</id><id>T1059</id><id>T1486</id></mitre>
  </rule>
</group>


